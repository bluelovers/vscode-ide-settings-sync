{
  "name": "vscode-ide-settings-sync",
  "displayName": "VSCode IDE Settings Sync",
  "version": "0.1.6",
  "description": "Synchronize IDE settings across multiple VSCode-based IDEs (Antigravity, VS Code Insiders, CodeBuddy CN, Windsurf, custom paths)",
  "categories": [
    "Other"
  ],
  "keywords": [
    "code-settings-sync",
    "keybindings",
    "multi-root ready",
    "settings-sync",
    "vscode-settings-sync",
    "vscode-sync",
    "workspace-sync",
    "Insiders",
    "Antigravity",
    "CodeBuddy CN",
    "Windsurf"
  ],
  "homepage": "https://github.com/bluelovers/vscode-ide-settings-sync#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/vscode-ide-settings-sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/vscode-ide-settings-sync.git"
  },
  "license": "CC-BY-NC-SA-4.0",
  "author": "",
  "publisher": "bluelovers",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "files": [
    "dist/webview/index.js",
    "dist/extension.js",
    "media/sidebar-icon.svg",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "node --run compile",
    "test": "node --run test:unit --",
    "test:unit": "node --run test:tsc && dotenv --override -- jest --passWithNoTests",
    "test:unit:coverage": "node --run test:unit -- --coverage",
    "test:unit:snapshot": "node --run test:unit -- --u",
    "test:unit:watch": "node --run test:unit -- --watch",
    "test:tsc": "dotenv --override -- tsc --noEmit & echo typescheck completed",
    "prebuild": "node --run test:unit:snapshot",
    "build": "node --run esbuild-base",
    "version:bump": "dotenv --override -- yarn-tool version",
    "version:bump:major": "node --run version:bump -- --bump major",
    "version:bump:minor": "node --run version:bump -- --bump minor",
    "version:bump:patch": "node --run version:bump -- --bump patch",
    "version:bump:prerelease": "node --run version:bump -- --bump prerelease",
    "prepublishOnly": "pnpm run version:bump",
    "publish": "pnpm run version:bump && node --run vscode:publish && node --run vscode:package",
    "publish:vscode": "node --run vscode:prepublish && node --run vscode:publish && node --run vscode:package",
    "postpublish": "node --run postpublish:changelog && node --run postpublish:git:commit && node --run postpublish:git:tag && node --run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md",
    "postpublish:git:commit": "git add ./test/__file_snapshots__ & git commit -m \"chore(release): publish\" . & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "ynpx --quiet @yarn-tool/tag",
    "postpublishOnly": "echo postpublishOnly",
    "compile": "dotenv --override -- tsc -p ./",
    "esbuild": "node --run esbuild-base --",
    "esbuild-base": "dotenv --override -- tsx esbuild.config",
    "esbuild-watch": "node --run esbuild-base -- --watch",
    "ncu": "dotenv --override -- yarn-tool ncu -u",
    "package": "pnpm run vscode:publish",
    "sort-package-json": "yarn-tool sort",
    "vscode:prepublish": "node --run esbuild-base -- --minify",
    "vscode:publish": "dotenv --override -- pnpm vsce publish --no-dependencies",
    "vscode:list": "dotenv --override -- pnpm vsce ls --no-dependencies",
    "vscode:package": "dotenv --override -- pnpm vsce package --no-dependencies",
    "watch": "dotenv --override -- tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-ide-settings-sync.openSync",
        "title": "Open IDE Settings Sync Panel",
        "category": "IDE Settings Sync"
      },
      {
        "command": "vscode-ide-settings-sync.refreshIDEs",
        "title": "Refresh IDE List",
        "category": "IDE Settings Sync"
      },
      {
        "command": "vscode-ide-settings-sync.syncSettings",
        "title": "Sync Selected Settings",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.exportCustomIDEs",
        "title": "Export Custom IDEs",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.exportSelectedSettings",
        "title": "Export Selected Settings",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.exportAll",
        "title": "Export All (Custom IDEs + Settings)",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.import",
        "title": "Import Settings",
        "category": "IDE Settings Sync"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-ide-settings-sync.openSync",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s",
        "when": "editorFocus || editorGroupFocus"
      },
      {
        "command": "vscode-ide-settings-sync.refreshIDEs",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "editorFocus || editorGroupFocus"
      }
    ],
    "menus": {
      "menubar/file": [
        {
          "command": "vscode-ide-settings-sync.openSync",
          "group": "z_custom"
        }
      ],
      "view/file": [
        {
          "command": "vscode-ide-settings-sync.openSync",
          "group": "z_custom"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-ide-settings-sync",
          "title": "IDE Settings Sync",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "vscode-ide-settings-sync": [
        {
          "id": "vscodeIdeSettingsSyncView",
          "name": "IDE Settings Sync",
          "icon": "media/sidebar-icon.svg",
          "type": "webview"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:vscodeIdeSettingsSyncView"
  ],
  "dependencies": {
    "@lazy-node/types-path": "^1.0.3",
    "@preact/signals": "^2.11.1",
    "js-yaml": "^5.3.0",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^6.0.1",
    "path-is-same": "^1.0.29",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "ts-type": "^3.0.13",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "upath2": "^3.1.25"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/vscode": "1.109.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "fs-extra": "^11.4.0",
    "jest": "^30.4.2",
    "memfs": "^4.68.1",
    "memfs-extra": "^1.0.4",
    "sass": "^1.103.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "unionfs": "^4.6.0"
  },
  "alias": {
    "react": "preact/compat",
    "react-dom/test-utils": "preact/test-utils",
    "react-dom": "preact/compat",
    "react/jsx-runtime": "preact/jsx-runtime"
  },
  "engines": {
    "vscode": ">=1.109.0"
  }
}
