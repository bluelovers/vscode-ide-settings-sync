{
  "name": "vscode-ide-settings-sync",
  "displayName": "VSCode IDE Settings Sync",
  "version": "0.0.6",
  "description": "Synchronize IDE settings across multiple VSCode-based IDEs (Antigravity, VS Code Insiders, CodeBuddy CN, Windsurf, custom paths)",
  "categories": [
    "Other"
  ],
  "keywords": [
    "code-settings-sync",
    "keybindings",
    "multi-root ready",
    "settings-sync",
    "vscode-settings-sync",
    "vscode-sync",
    "workspace-sync",
    "Insiders",
    "Antigravity",
    "CodeBuddy CN",
    "Windsurf"
  ],
  "homepage": "https://github.com/bluelovers/vscode-ide-settings-sync#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/vscode-ide-settings-sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/vscode-ide-settings-sync.git"
  },
  "license": "ISC",
  "author": "",
  "publisher": "bluelovers",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "files": [
    "dist/extension.js"
  ],
  "scripts": {
    "pretest": "node --run compile",
    "test": "node --run test:unit --",
    "test:unit": "jest --passWithNoTests",
    "test:unit:coverage": "node --run test:unit -- --coverage",
    "test:unit:snapshot": "node --run test:unit -- --u",
    "test:unit:watch": "node --run test:unit -- --watch",
    "prebuild": "node --run test:unit:snapshot",
    "build": "node --run esbuild-base",
    "version:bump": "yarn-tool version",
    "version:bump:major": "node --run version:bump -- --bump major",
    "version:bump:minor": "node --run version:bump -- --bump minor",
    "version:bump:patch": "node --run version:bump -- --bump patch",
    "version:bump:prerelease": "node --run version:bump -- --bump prerelease",
    "prepublishOnly": "pnpm run version:bump",
    "publish": "pnpm run version:bump && pnpm run vscode:publish",
    "publish:vscode": "node --run vscode:prepublish && node --run vscode:publish",
    "postpublish": "node --run postpublish:changelog && node --run postpublish:git:commit && node --run postpublish:git:tag && node --run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md",
    "postpublish:git:commit": "git add ./test/__file_snapshots__ & git commit -m \"chore(release): publish\" . & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "ynpx --quiet @yarn-tool/tag",
    "postpublishOnly": "echo postpublishOnly",
    "compile": "tsc -p ./",
    "esbuild": "node --run esbuild-base --",
    "esbuild-base": "tsx esbuild.config",
    "esbuild-watch": "node --run esbuild-base -- --watch",
    "ncu": "yarn-tool ncu -u",
    "package": "pnpm run vscode:publish",
    "sort-package-json": "yarn-tool sort",
    "vscode:prepublish": "node --run esbuild-base -- --minify",
    "vscode:publish": "pnpm vsce publish --no-dependencies",
    "vscode:list": "pnpm vsce ls --no-dependencies",
    "vscode:package": "pnpm vsce package",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-ide-settings-sync.openSync",
        "title": "Open IDE Settings Sync Panel",
        "category": "IDE Settings Sync"
      },
      {
        "command": "vscode-ide-settings-sync.refreshIDEs",
        "title": "Refresh IDE List",
        "category": "IDE Settings Sync"
      },
      {
        "command": "vscode-ide-settings-sync.syncSettings",
        "title": "Sync Selected Settings",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.exportCustomIDEs",
        "title": "Export Custom IDEs",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.exportSelectedSettings",
        "title": "Export Selected Settings",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.exportAll",
        "title": "Export All (Custom IDEs + Settings)",
        "category": "IDE Settings Sync"
      },
      {
        "command": "ide-sync.import",
        "title": "Import Settings",
        "category": "IDE Settings Sync"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-ide-settings-sync.openSync",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s",
        "when": "editorFocus || editorGroupFocus"
      },
      {
        "command": "vscode-ide-settings-sync.refreshIDEs",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "editorFocus || editorGroupFocus"
      }
    ],
    "menus": {
      "menubar/file": [
        {
          "command": "vscode-ide-settings-sync.openSync",
          "group": "z_custom"
        }
      ],
      "view/file": [
        {
          "command": "vscode-ide-settings-sync.openSync",
          "group": "z_custom"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^5.1.6",
    "path-is-same": "^1.0.26",
    "preact": "^10.28.4",
    "preact-render-to-string": "^6.6.6",
    "ts-type": "^3.0.1"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/jest": "^30.0.0",
    "@types/nanoid": "^3.0.0",
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "esbuild-sass-plugin": "^3.6.0",
    "jest": "^30.2.0",
    "sass": "^1.97.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "vscode": "^1.109.0"
  }
}
