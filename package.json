{
  "name": "vscode-ide-settings-sync",
  "displayName": "VSCode IDE Settings Sync",
  "publisher": "bluelovers",
  "description": "Synchronize IDE settings across multiple VSCode-based IDEs (Antigravity, VS Code Insiders, CodeBuddy CN, custom paths)",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-ide-settings-sync.openSync",
        "title": "Open IDE Settings Sync Panel",
        "category": "IDE Settings Sync"
      },
      {
        "command": "vscode-ide-settings-sync.refreshIDEs",
        "title": "Refresh IDE List",
        "category": "IDE Settings Sync"
      },
      {
        "command": "vscode-ide-settings-sync.syncSettings",
        "title": "Sync Selected Settings",
        "category": "IDE Settings Sync"
      }
    ],
    "menus": {
      "menubar/file": [
        {
          "command": "vscode-ide-settings-sync.openSync",
          "group": "z_custom"
        }
      ],
      "view/file": [
        {
          "command": "vscode-ide-settings-sync.openSync",
          "group": "z_custom"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-ide-settings-sync.openSync",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s",
        "when": "editorFocus || editorGroupFocus"
      },
      {
        "command": "vscode-ide-settings-sync.refreshIDEs",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "editorFocus || editorGroupFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node --run esbuild-base -- --minify",
    "esbuild-base": "tsx esbuild.config",
    "esbuild": "node --run esbuild-base",
    "esbuild-watch": "node --run esbuild-base -- --watch",
    "build": "node --run esbuild-base",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "node --run compile",
    "test": "node --run test:unit",
    "test:unit": "jest",
    "test:unit:watch": "node --run test:unit -- --watch",
    "test:unit:coverage": "node --run test:unit -- --coverage"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "esbuild-sass-plugin": "^3.6.0",
    "jest": "^30.2.0",
    "sass": "^1.97.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "path-is-same": "^1.0.26",
    "preact": "^10.28.4",
    "preact-render-to-string": "^6.6.6",
    "ts-type": "^3.0.1"
  },
  "packageManager": "pnpm@11.0.0-dev.1005+sha512.91f84a392eea348ea4852a182912d2520273a4336f933b78cc44bc931eb999923c097e9433a9b355adc1f725725ea99082fc9f032a559df832632e764c92c798"
}
