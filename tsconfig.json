{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "declaration": true,
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "preserveConstEnums": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}
